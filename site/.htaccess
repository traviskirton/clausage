# Send http:// and www. to https://clausage.ai, keeping the path (one 301).
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://clausage.ai%{REQUEST_URI} [L,R=301]

# Unknown paths get the branded 404 page, with a real 404 status.
ErrorDocument 404 /404.html
