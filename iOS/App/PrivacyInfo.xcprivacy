<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking and no data collected: usage comes from claude.ai straight to this device. Feedback is a
	     user-initiated email from the user's own Mail app (optional disclosure). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Settings and state this app reads and writes itself. -->
				<string>CA92.1</string>
				<!-- The App Group shared between the app and its widgets. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
